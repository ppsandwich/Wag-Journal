# Browser: Supabase public values only. Never put a secret in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
# Rust API and reminder worker; use the Supabase transaction pooler URL on Vercel.
DATABASE_URL=postgres://wag:wag_local_only@127.0.0.1:54329/wag
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only key for personal account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Local integration tests only. Never enable on Vercel.
LOCAL_DEV_AUTH=false
PORT=3001
# Schedule /api/reminders once per minute using QStash with this bearer token.
REMINDER_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-your-support-address@example.com
APP_ORIGIN=http://localhost:5173
